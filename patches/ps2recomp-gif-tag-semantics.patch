@@ -691,7 +689,12 @@
 
         recordGifTagDebugEventUnlocked(sizeBytes, nloop, flg, nreg);
 
-        bool pre = ((tagLo >> 46) & 1) != 0;
+        // GOW-Port: NLOOP=0 no emite registros; conserva PRIM, la cola de vertices y Q.
