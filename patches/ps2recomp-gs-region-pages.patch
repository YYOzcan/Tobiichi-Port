+        std::vector<uint8_t> seed(vram.size());
+        for(unsigned i=0;i<3;++i) {
+            const auto loc=GSSwizzle::Locate(format,0,8,coordinates[i],coordinates[i]);
+            const uint32_t color=indexed?i+1:format.kind==GSSwizzle::Kind::Bits16?0x8421u+i*0x123u:colors[i];
+            GSSwizzle::StoreAt(format,seed.data()+loc.byte,loc.shift,color);
