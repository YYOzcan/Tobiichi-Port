+// GOW-Port: limites que atraviesan paginas, TBP no alineado y vuelta de los 4 MiB.
+// Cada sprite escribe un pixel; TEXFLUSH del control CPU renueva la fuente por Submit.
+void gpuRegionEdges(TestCase &t,bool hardware)
+{
+    struct Restore {unsigned csr=_mm_getcsr();~Restore(){_mm_setcsr(csr);}} restore;
+    _mm_setcsr(restore.csr & ~_MM_ROUND_MASK);
+    std::vector<uint8_t> vram(GSSwizzle::kMemorySize);
+    auto gpu=std::make_unique<GSGpuBackend>();auto *raw=gpu.get();
+    raw->SetHardwareRasterAllowed(hardware);
+    GSThreadedBackend backend(std::move(gpu));
+    for(unsigned psm:{0u,1u,2u,10u,48u,49u,50u,58u}) for(unsigned mode:{2u,3u})
+    for(unsigned base:{0u,31u,16383u}) for(bool linear:{false,true})
+    for(bool cache:{false,true}) for(bool snapshot:{false,true}) {
+        const auto &format=GSSwizzle::GetFormat(psm);
+        const unsigned highU=mode==2?64:127,highV=mode==2?32:63;
+        std::vector<uint8_t> seed(vram.size());
+        for(unsigned y:{31u,highV})for(unsigned x:{63u,highU}) {
+            const auto loc=GSSwizzle::Locate(format,base,8,x,y);
+            const uint32_t color=format.kind==GSSwizzle::Kind::Bits16?0x8421u+x+y*17u:
+                0x80000000u|((x*37u+y*13u)&255u)|(((x*11u+y*29u)&255u)<<8)|(((x*53u+y*47u)&255u)<<16);
+            GSSwizzle::StoreAt(format,seed.data()+loc.byte,loc.shift,color);
+        }
+        const auto endpoint=GSSwizzle::Locate(format,base,8,highU,highV);
+        std::vector<GSPrimitiveBatch> draws;
+        for(unsigned i=0;i<3;++i) {
+            GSPrimitiveBatch b{};b.vertexCount=2;b.state.prim.type=GS_PRIM_SPRITE;
+            b.state.prim.tme=true;b.state.prim.fst=true;b.state.linearFilter=linear;
+            b.state.textureWidth=b.state.textureHeight=4;b.state.colclamp=1;
+            b.state.texa.ta0=b.state.texa.ta1=128;
+            auto &c=b.state.context;c.frame.fbp=endpoint.byte/8192u;c.frame.fbw=8;
+            c.scissor={0,15,0,15};c.zbuf.zbp=104;c.zbuf.psm=GS_PSM_Z24;c.zbuf.zmask=true;
+            c.test=0x30000;c.tex1=linear?0x60:0;c.tex0.psm=uint8_t(psm);c.tex0.tbp0=base;
+            c.tex0.tbw=8;c.tex0.tw=c.tex0.th=2;c.tex0.tcc=1;c.tex0.tfx=1;
+            const unsigned minU=mode==2?63:64,maxU=mode==2?64:63;
+            const unsigned minV=mode==2?31:32,maxV=mode==2?32:31;
+            c.clamp=mode|(uint64_t(mode)<<2)|(uint64_t(minU)<<4)|(uint64_t(maxU)<<14)|
+                (uint64_t(minV)<<24)|(uint64_t(maxV)<<34);
+            for(auto &v:b.vertices){v.r=v.g=v.b=v.a=128;v.z=7;v.q=1;v.u=64*16;v.v=32*16;}
+            b.vertices[0].x=float(i);b.vertices[1].x=float(i+1);b.vertices[1].y=1;
+            draws.push_back(b);
+        }
+        auto cpuVram=seed;GSCpuBackend cpu;cpu.Initialize(cpuVram.data(),uint32_t(cpuVram.size()));
+        for(const auto &b:draws){cpu.TextureFlush();cpu.Submit(b);}
+        std::vector<uint8_t> expected;cpu.SnapshotVram(expected);
+        t.IsTrue(seed!=expected,"El control de borde realmente cambia VRAM");
+        bool observedHardware=false;
+        const auto deadline=std::chrono::steady_clock::now()+std::chrono::seconds(12);
+        do {
+            backend.Sync(GSSyncReason::Finish);std::copy(seed.begin(),seed.end(),vram.begin());
+            raw->SetTexturePageCacheEnabled(cache);raw->SetFeedbackSnapshotEnabled(snapshot);
+            backend.Initialize(vram.data(),uint32_t(vram.size()));
+            if(dynamic_cast<GSGpuBackend*>(&backend.Inner())!=raw || !raw->IsReady()){t.Fail("OpenGL requerido");return;}
+            const auto before=raw->GetStats();
+            for(const auto &draw:draws)backend.Submit(draw);
+            backend.Sync(GSSyncReason::DebugReadback);
+            std::vector<uint8_t> actual;backend.SnapshotVram(actual);
+            const auto after=raw->GetStats();
+            t.IsTrue(actual==expected,"Cruce de pagina y wrap preservan toda la VRAM");
+            t.IsTrue(after.batches-before.batches==3,"El borde realmente leido conserva tres lotes");
+            t.IsTrue(after.flushTexture-before.flushTexture==2,"Dos riesgos reales fuerzan sincronizacion");
+            t.IsTrue(after.prims-before.prims==3,"Tres sprites realmente dibujados");
+            if(after.tiles-before.tiles==0 && after.prims-before.prims==3)observedHardware=true;
+            if(!hardware)t.IsTrue(after.tiles>before.tiles,"Compute efectivo en los bordes");
+            if(hardware && !observedHardware)std::this_thread::sleep_for(std::chrono::milliseconds(20));
+        } while(hardware && !observedHardware && std::chrono::steady_clock::now()<deadline);
+        if(hardware)t.IsTrue(observedHardware,"Hardware efectivo en los bordes");
+    }
+}
