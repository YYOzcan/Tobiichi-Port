+        const auto &rgba=GSSwizzle::GetFormat(GS_PSM_CT32);
+        for(unsigned i=0;i<256;++i) {
+            const auto loc=GSSwizzle::Locate(rgba,8192,1,i,0);
+            const uint32_t color=0x80000000u|((i*37u+13u)&255u)|(((i*11u+29u)&255u)<<8)|(((i*53u+47u)&255u)<<16);
+            GSSwizzle::StoreAt(rgba,seed.data()+loc.byte,loc.shift,color);
+        }
+        auto cpuVram=seed;
+        GSCpuBackend cpu;cpu.Initialize(cpuVram.data(),uint32_t(cpuVram.size()));
+        std::vector<GSPrimitiveBatch> draws;
+        for(unsigned i=0;i<(alias?4u:3u);++i) {
+            const unsigned limit=i<3?coordinates[i]:0u,minimum=mode==2?limit:0;
+            const unsigned maximum=mode==2?700:limit;
+            GSPrimitiveBatch b{};b.vertexCount=2;b.state.prim.type=GS_PRIM_SPRITE;
+            b.state.prim.tme=true;b.state.prim.fst=true;b.state.linearFilter=linear;
+            b.state.textureWidth=b.state.textureHeight=4;b.state.colclamp=1;
+            b.state.texa.ta0=b.state.texa.ta1=128;b.state.texclut.cbw=1;
+            auto &c=b.state.context;c.frame.fbw=8;c.scissor={0,15,0,15};c.zbuf.zbp=104;
+            c.zbuf.psm=GS_PSM_Z24;c.zbuf.zmask=true;c.test=0x30000;c.tex1=linear?0x60:0;
+            c.tex0.psm=uint8_t(psm);c.tex0.tbw=8;c.tex0.tw=c.tex0.th=2;c.tex0.tcc=1;c.tex0.tfx=1;
+            c.tex0.csm=1;c.tex0.cld=1;c.tex0.cbp=8192;
+            c.clamp=mode|(uint64_t(mode)<<2)|(uint64_t(minimum)<<4)|(uint64_t(maximum)<<14)|
+                (uint64_t(minimum)<<24)|(uint64_t(maximum)<<34);
+            for(auto &v:b.vertices){v.r=v.g=v.b=v.a=128;v.z=7;v.q=1;v.u=v.v=uint16_t(limit*16);}
+            b.vertices[0].x=float(i);b.vertices[1].x=float(i+1);b.vertices[1].y=1;
+            draws.push_back(b);
+        }
+        if(indexed)cpu.LoadClut(draws.front().state.context.tex0,draws.front().state.texclut);
+        for(const auto &b:draws)cpu.Submit(b);
