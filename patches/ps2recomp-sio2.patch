+            m_sio2.dmaIn(m_ram.data() + madr, blockBytes, blockBytes != 0u ? bytes / blockBytes : 0u);
+        else
+        {
+            m_sio2.dmaOut(m_ram.data() + madr, bytes);
+            markOwned(madr, bytes);
+        }
+        m_hardware[chcrAddress - 8u] = madr + static_cast<uint32_t>(bytes);
+    }
