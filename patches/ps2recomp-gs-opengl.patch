+void GSGpuBackend::Initialize(uint8_t *vram, uint32_t vramSize)
+{
+    Impl &d = *m_impl;
+    d.hostVram = vram;
+    d.hostVramSize = vramSize;
+    d.resetBatch();
+    Reset();
+    if (d.ensure())
