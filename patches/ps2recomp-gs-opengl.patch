+    GLuint profQuery()
+    {
+        if (prof.freeQueries.empty())
+        {
+            prof.freeQueries.resize(256u);
+            gl().GenQueries(256, prof.freeQueries.data());
+        }
+        const GLuint query = prof.freeQueries.back();
+        prof.freeQueries.pop_back();
+        return query;
+    }
