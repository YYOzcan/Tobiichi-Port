+    void Context::DestroyWorker(void *worker)
+    {
+        if (!worker)
+            return;
+        if (wglGetCurrentContext() == static_cast<HGLRC>(worker))
+            wglMakeCurrent(nullptr, nullptr);
+        wglDeleteContext(static_cast<HGLRC>(worker));
+    }
