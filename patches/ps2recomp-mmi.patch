+        else if (kind == 1)
+            d[i] = static_cast<int32_t>(value >> amount);
+        else
+            d[i] = static_cast<int32_t>(value) >> amount;
+    }
+    return _mm_load_si128(reinterpret_cast<const __m128i *>(d));
