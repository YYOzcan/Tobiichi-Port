+inline __m128i ps2_pshiftvw(__m128i rs, __m128i rt, int kind)
+{
+    alignas(16) uint32_t s[4], t[4];
+    alignas(16) int64_t d[2];
+    _mm_store_si128(reinterpret_cast<__m128i *>(s), rs);
+    _mm_store_si128(reinterpret_cast<__m128i *>(t), rt);
+    for (int i = 0; i < 2; ++i)
