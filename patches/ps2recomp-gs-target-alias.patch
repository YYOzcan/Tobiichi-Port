 namespace
 {
+// GOW-Port: color/Z con la misma base tienen swizzles distintos. Dos medias
+// paginas se afectan entre primitivas aunque sus rectangulos XY sean disjuntos.
+void gpuTargetAliasing(TestCase &t,bool hardware)
+{
+    std::vector<uint8_t> vram(GSSwizzle::kMemorySize);
+    auto gpu=std::make_unique<GSGpuBackend>();auto *raw=gpu.get();
+    raw->SetHardwareRasterAllowed(hardware);raw->SetFeedbackSnapshotEnabled(false);
+    GSThreadedBackend backend(std::move(gpu));
+    for(unsigned fixture=0;fixture<5;++fixture) {
+        const bool wide=fixture==4,disjoint=fixture==1,noDepth=fixture==2,readOnly=fixture==3;
+        const bool hazard=!disjoint && !noDepth;
+        std::vector<uint8_t> seed(vram.size());
+        for(size_t i=0;i<seed.size();i+=4) {
+            const uint32_t word=wide?0x00123456u:0xA5123456u;
+            std::memcpy(seed.data()+i,&word,4);
+        }
+        auto cpuVram=seed;GSCpuBackend cpu;cpu.Initialize(cpuVram.data(),uint32_t(cpuVram.size()));
+        std::vector<GSPrimitiveBatch> draws;
+        for(unsigned i=0;i<2;++i) {
+            GSPrimitiveBatch b{};b.vertexCount=2;b.state.prim.type=GS_PRIM_SPRITE;b.state.colclamp=1;
+            auto &c=b.state.context;c.frame={320,1,uint8_t(wide?GS_PSM_CT32:GS_PSM_CT24),0};
+            c.zbuf={disjoint?104u:320u,uint8_t(wide?GS_PSM_Z32:GS_PSM_Z24),noDepth||readOnly};
+            c.scissor={0,63,0,63};c.test=noDepth?0x30000:0x70000;
+            b.vertices[0].x=float(i*32);b.vertices[1].x=float((i+1)*32);b.vertices[1].y=64;
+            b.vertices[1].z=0x808080;b.vertices[1].r=i?0xAA:0x11;b.vertices[1].g=i?0xBB:0x22;
+            b.vertices[1].b=i?0xCC:0x33;b.vertices[1].a=128;
+            draws.push_back(b);cpu.Submit(b);
+        }
+        std::vector<uint8_t> expected;cpu.SnapshotVram(expected);
+        t.IsTrue(expected!=seed,"El control de alias produce escrituras reales");
+        bool observedHardware=false;unsigned pass=0;
+        const auto deadline=std::chrono::steady_clock::now()+std::chrono::seconds(12);
+        do {
+            backend.Sync(GSSyncReason::Finish);std::copy(seed.begin(),seed.end(),vram.begin());
+            backend.Initialize(vram.data(),uint32_t(vram.size()));
+            if(dynamic_cast<GSGpuBackend*>(&backend.Inner())!=raw || !raw->IsReady()){t.Fail("OpenGL requerido");return;}
+            backend.Sync(GSSyncReason::Finish);const auto before=raw->GetStats();
+            for(const auto &draw:draws)backend.Submit(draw);
+            backend.Sync(GSSyncReason::DebugReadback);std::vector<uint8_t> actual;backend.SnapshotVram(actual);
+            const auto after=raw->GetStats();
+            t.IsTrue(actual==expected,"Orden color/Z conserva los 4 MiB frente a CPU");
+            t.IsTrue(after.batches-before.batches==(hazard?2u:1u),"Alias separa lotes; buffers disjuntos y Z inactivo no");
+            t.IsTrue(after.flushTarget-before.flushTarget==(hazard?1u:0u),"Separacion por destino, sin inventar textura");
+            t.IsTrue(after.flushTexture-before.flushTexture==0u,"El control no lee texturas");
+            t.IsTrue(after.prims-before.prims==2u,"Ambos sprites se ejecutan en OpenGL");
+            if(after.tiles-before.tiles==0 && after.prims-before.prims==2u)observedHardware=true;
+            if(!hardware)t.IsTrue(after.tiles>before.tiles,"Compute real requerido");
+            ++pass;if(hardware && !observedHardware)std::this_thread::sleep_for(std::chrono::milliseconds(20));
+        } while(pass<4 || (hardware && !observedHardware && std::chrono::steady_clock::now()<deadline));
+        if(hardware)t.IsTrue(observedHardware,"Hardware efectivo, sin tiles compute");
+    }
+}
